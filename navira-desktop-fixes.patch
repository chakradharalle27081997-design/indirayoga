+++ b/index.html
@@ -263,7 +263,33 @@
   .hero-float-card strong { font-family: 'Fraunces', serif; font-size: 0.95rem; color: var(--olive-black); display: block; }
   .hero-float-card span { font-size: 0.72rem; color: var(--muted); }
 
-  /* ═══════════ MARQUEE ═══════════ */
+  .hero-accent {
+    position: absolute; border-radius: 50%; pointer-events: none;
+    border: 1px solid rgba(139,156,107,0.35); opacity: 0;
+  }
+  .hero-accent.leaf { border: none; opacity: 0; }
+  .hero-accent.leaf svg { width: 100%; height: 100%; }
+
+  /* ═══════════ WIDE DESKTOP ENRICHMENT ═══════════ */
+  @media (min-width: 1300px) {
+    .hero-logo-wrap { width: 420px; height: 420px; }
+    .hero-accent { opacity: 1; }
+    .hero-accent.ring1 { width: 560px; height: 560px; top: 50%; left: 50%; transform: translate(-50%,-50%); animation: spin 60s linear infinite reverse; }
+    .hero-accent.ring2 { width: 500px; height: 500px; top: 50%; left: 50%; transform: translate(-50%,-50%); border-style: dashed; opacity: 0.5; }
+    .hero-accent.leaf { width: 46px; opacity: 0.5; animation: floaty 6s ease-in-out infinite; }
+    .hero-accent.leaf1 { top: 2%; right: 4%; animation-delay: 0.3s; }
+    .hero-accent.leaf2 { bottom: 8%; right: -2%; width: 34px; animation-delay: 1.4s; }
+    .hero-accent.dotcluster { top: 12%; left: -2%; opacity: 0.7; }
+
+    .philosophy { padding: 9rem 5rem; }
+    .philosophy-grid { gap: 5rem; }
+    .infinity-svg { max-width: 520px; }
+    .philosophy-visual { position: relative; }
+    .philosophy-visual::before {
+      content: ''; position: absolute; width: 620px; height: 620px; border-radius: 50%;
+      background: radial-gradient(circle, rgba(190,147,70,0.1) 0%, transparent 68%);
+    }
+  }
   .marquee { background: var(--olive); overflow: hidden; padding: 0.85rem 0; position: relative; }
   .marquee-track { display: flex; width: max-content; animation: scroll-left 32s linear infinite; }
   .marquee-track span {
@@ -410,16 +436,12 @@
 
